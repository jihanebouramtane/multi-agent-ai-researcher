# Copie ce fichier en .env et remplis UNE ou plusieurs cles.
# Les cles du .env ne sont jamais affichees dans l'interface.
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Optionnel : augmente la limite de l'API GitHub (60 -> 5000 requetes/heure)
GITHUB_TOKEN=
# Nombre maximum de recherches par utilisateur toutes les 10 minutes
MAX_RUNS_PER_10_MIN=5
